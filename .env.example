# Copy to .env and fill YOUR OpenAI-compatible provider settings.
# The launcher never reads or copies another user's ~/.hermes credentials.
BAMO_API_KEY=
BAMO_API_BASE=https://your-provider.example/v1
BAMO_MODEL=your-model

# Optional; localhost:8090 is the normal browser address.
PORT=8090
# HOST=0.0.0.0
# BAMO_DISPLAY=:99
# BAMO_HERMES_HOME=/absolute/path/to/your/hermes-profile
# BAMO_BLENDER_ARCHIVE=/absolute/path/to/blender-5.2.2-linux-x64.tar.xz
